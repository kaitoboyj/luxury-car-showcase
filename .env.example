# ── Supabase — browser-safe (VITE_ prefix = exposed to the client) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# ── Supabase — server / CLI only (never exposed to the browser) ──
# Keep the service-role SECRET key in .env.local (git-ignored), not here:
#   SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ── Admin / Mix Man page password ──
MIXMAN_PASSWORD=choose
ADMIN_PASSWORD=choose

# ── Public site URL (your Netlify URL) — used for absolute social-preview image URLs ──
VITE_SITE_URL=
