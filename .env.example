# Supabase
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_DB_URL="postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# Same values re-exposed to the browser via Vite
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_ANON_KEY="your-publishable-key"

# Admin dashboard password (/admin and /mixman)
ADMIN_PASSWORD="choose"
MIXMAN_PASSWORD="choose"

# Public site URL (your Netlify URL) — used for absolute social-preview image URLs
VITE_SITE_URL="https://motorbay.netlify.app"
